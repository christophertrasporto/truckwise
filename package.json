{
  "name": "truckwise",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.mts",
    "db:migrate:live": "tsx scripts/migrate.mts",
    "db:seed:live": "tsx scripts/seed.mts",
    "db:seed": "tsx --env-file=.env scripts/seed.mts",
    "db:embedded": "tsx scripts/embedded-postgres.mts",
    "db:seed-demo": "tsx --env-file=.env scripts/seed-demo.mts",
    "db:reset": "tsx --env-file=.env scripts/reset-db.mts",
    "test:e2e": "playwright test",
    "jobs:expire": "tsx --env-file=.env scripts/expire-offers.mts",
    "jobs:work": "tsx --env-file=.env scripts/work-jobs.mts",
    "db:to-utf8": "tsx --env-file=.env scripts/convert-db-to-utf8.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "exceljs": "^4.4.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}

# Settings for the live site. Put these in Railway (Variables). Never commit real values.
APP_ENV=live
COOKIE_SECURE=true
LOG_LEVEL=info

# Supabase: copy the "Session pooler" connection string (Project -> Connect). Add ?sslmode=require at the end.
# The owner connection is used ONLY by the deploy step that applies database changes.
DATABASE_ADMIN_URL=postgres://postgres.YOURPROJECTREF:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# The app connection uses a separate restricted user created by the migration. Same host, user is smartload_app.YOURPROJECTREF.
DATABASE_URL=postgres://smartload_app.YOURPROJECTREF:CHOOSE-A-LONG-RANDOM-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Must be the same password as in DATABASE_URL above.
APP_DB_PASSWORD=CHOOSE-A-LONG-RANDOM-PASSWORD

# Railway volume mounted at /data keeps uploaded photos and documents across deploys.
STORAGE_DIR=/data/storage
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_SIGNING_SECRET=

SESSION_TTL_DAYS=14
RUN_JOBS_IN_PROCESS=true

# First owner account, read once by: npm run db:seed:live
COMPANY_NAME=Lalolu Trucking
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Optional: phone alerts. Without these, alerts stay inside the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
SMS_PROVIDER=stub

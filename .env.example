# --- Database ---
# Owner/superuser connection. Used ONLY by migrations, seed and test setup (bypasses RLS).
DATABASE_ADMIN_URL=postgres://smartload:smartload@localhost:5432/smartload
# Application connection. Role `smartload_app` (created by migration, subject to RLS).
DATABASE_URL=postgres://smartload_app:smartload_app@localhost:5432/smartload
# Password assigned to the smartload_app role by `npm run db:migrate`. Must match DATABASE_URL.
APP_DB_PASSWORD=smartload_app
# Test database name (created automatically by the test setup, on the same server as DATABASE_ADMIN_URL).
TEST_DB_NAME=smartload_test

# --- App ---
# Session cookie lifetime in days.
SESSION_TTL_DAYS=14
# Set to "true" to mark the session cookie Secure (required in production over HTTPS).
COOKIE_SECURE=false
LOG_LEVEL=info

# --- Object storage (S3-compatible; MinIO locally). Used from Phase 2. ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=smartload
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Mail (Mailpit locally). Used from Phase 6. ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Not yet wired (see docs/PROGRESS.md): SMS provider, Web Push VAPID keys, malware scanner, billing provider ---

# --- Initial owner account (read by `npm run db:seed`; the password is only used when creating the account) ---
COMPANY_NAME=Lalolu Trucking
OWNER_NAME=Your Name
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=choose-a-strong-password

# --- File storage (local disk; S3/MinIO adapter not built yet) ---
STORAGE_DIR=.storage
# Long random string used to sign short-lived file URLs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_SIGNING_SECRET=change-me

# --- Background jobs and malware scanning ---
# Set to false to run the worker yourself (npm run jobs:work) instead of inside the web server.
RUN_JOBS_IN_PROCESS=true
# Optional ClamAV daemon. When unset a stub scanner is used that only flags the EICAR test string (NOT real protection).
CLAMD_HOST=
CLAMD_PORT=3310

# --- Alerts: Web Push (phones/browsers) ---
# Generate once with: npx web-push generate-vapid-keys. Without these, alerts are in-app only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Alerts: text messages (urgent items only, opt-in per person) ---
# stub (default: sends nothing), semaphore or twilio. A real provider needs its credentials below.
SMS_PROVIDER=stub
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Most text messages one person may receive per day.
SMS_DAILY_LIMIT=10

# --- Timers ---
# Minutes before an unreviewed delivery exception is escalated to the owner and ops manager.
EXCEPTION_ESCALATION_MINUTES=30
